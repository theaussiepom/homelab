    "zabbix": {
      "name": "homelab-monitoring",
      "services": {
        "zabbix_server": {
          "image": "zabbix/zabbix-server-pgsql:ubuntu-7.0.32@sha256:bc0505eff209ab5ca9cfb6c7363f061b03b1a31ed529102274413febae54f002",
          "pull_policy": "missing",
          "restart": "always",
          "mem_limit": "768m",
          "cpus": 1,
          "pids_limit": 128,
          "stop_grace_period": "60s",
          "logging": {
            "driver": "json-file",
            "options": {
              "max-size": "10m",
              "max-file": "3"
            }
          },
          "environment": {
            "DB_SERVER_HOST": "postgres",
            "DB_SERVER_PORT": "5432",
            "POSTGRES_USER": "zabbix",
            "POSTGRES_DB": "zabbix",
            "POSTGRES_PASSWORD_FILE": "/run/secrets/database-password",
            "ZBX_DBTLSCONNECT": "required",
            "TZ": "Etc/UTC",
            "ZBX_STARTREPORTWRITERS": "0",
            "ZBX_STARTBROWSERPOLLERS": "0"
          },
          "volumes": [
            {
              "type": "bind",
              "source": "/opt/homelab-app/runtime/database-password",
              "target": "/run/secrets/database-password",
              "read_only": true,
              "bind": {
                "create_host_path": false
