          "start_period": "30s",
          "test": [
            "CMD",
            "node",
            "-e",
            "const c=require('./build/src/config').loadConfig();\nconst slug=require('./build/src/homeassistant').hostSlug(c.winets[0].host);\nconst topics=new Set(['winet-extractor/'+slug+'/status','winet-extractor/'+slug+'/availability']);\nconst latest=new Map([...topics].map(topic=>[topic,'unknown']));\nconst client=require('mqtt').connect(c.mqttUrl,{reconnectPeriod:0,connectTimeout:5000});\nconst done=code=>{client.end(true);process.exit(code)};\nsetTimeout(()=>done(1),10000);\nclient.on('error',()=>done(1));\nclient.on('connect',()=>client.subscribe([...topics]));\nclient.on('message',(topic,payload)=>{if(!latest.has(topic))return;latest.set(topic,payload.toString());if([...latest.values()].every(value=>value==='online'))done(0)});\n"
          ],
          "timeout": "15s"
        },
        "image": "ghcr.io/theaussiepom/winet-extractor@sha256:82c6b886967995f0a3cfe6fb5e20eeef70d10aa525d5bd824064eb272e1ce51a",
