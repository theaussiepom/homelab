        },
        "role_addresses": {
          "service": "198.18.33.26"
        },
        "software_selection": {
          "packages": [
            "influxdb2=2.7.12-1",
            "influxdb2-cli=2.7.5-1"
          ]
        }
      },
      "compose_file": "/opt/homelab-app/compose.yml",
      "expected": [
        {
          "argv": [
            "python3",
            "-c",
            "import subprocess; assert subprocess.check_output(['systemctl','is-enabled','influxdb'],text=True).strip()=='enabled'; subprocess.run(['systemctl','is-active','--quiet','influxdb'],check=True); print('SERVICE_OK')"
          ],
          "expect": "SERVICE_OK",
          "name": "Service is enabled and active"
        },
        {
          "argv": [
            "python3",
            "-c",
            "import json,urllib.request; d=json.load(urllib.request.urlopen('http://198.18.33.26:8086/health',timeout=5)); assert d['status']=='pass' and d['version']=='v2.7.12'; print('INFLUX_OK')"
          ],
          "expect": "INFLUX_OK",
          "name": "InfluxDB health without initial setup or application data"
        },
        {
          "argv": [
            "python3",
            "-c",
            "import socket; s=socket.create_connection(('198.18.33.26',8086),timeout=5); s.close(); print('BACKEND_OK')"
          ],
          "expect": "BACKEND_OK",
          "name": "Backend TCP listener"
        }
      ],
      "guest": {}
    },
