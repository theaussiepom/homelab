          "127.0.0.1:5335:53/udp"
        ]
      }
    }
  },
  "zigbee_health": {
    "test": [
      "CMD",
      "node",
      "-e",
      "const h=require('http');const q=h.get('http://127.0.0.1:8099/',r=>process.exit(r.statusCode===200?0:1));q.setTimeout(3000,()=>{q.destroy();process.exit(1)});q.on('error',()=>process.exit(1))"
    ],
    "start_period": "30s",
    "interval": "5s",
    "retries": 30,
    "timeout": "4s"
  },
