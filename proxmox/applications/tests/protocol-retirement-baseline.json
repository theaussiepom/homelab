{
  "identity": {
    "name": "homelab-identity",
    "services": {
      "server": {
        "image": "ghcr.io/goauthentik/server@sha256:dc07e81b4462a1dad9c6720f4c73993e37d7cb2d2f94a306187318704d112e71",
        "pull_policy": "missing",
        "restart": "always",
        "mem_limit": "768m",
        "cpus": 1,
        "pids_limit": 128,
        "stop_grace_period": "60s",
        "logging": {
          "driver": "json-file",
          "options": {
            "max-size": "10m",
            "max-file": "3"
          }
        },
        "environment": {
          "AUTHENTIK_EMAIL__HOST": "smtp.example.invalid",
          "AUTHENTIK_EMAIL__FROM": "sso@example.invalid",
          "AUTHENTIK_EMAIL__USE_TLS": "true",
          "TZ": "Etc/UTC",
          "AUTHENTIK_SECRET_KEY": "file:///run/secrets/authentik-secret-key",
          "AUTHENTIK_POSTGRESQL__HOST": "postgres",
          "AUTHENTIK_POSTGRESQL__USER": "authentik",
          "AUTHENTIK_POSTGRESQL__NAME": "authentik",
          "AUTHENTIK_POSTGRESQL__PASSWORD": "file:///run/secrets/postgresql-password",
          "AUTHENTIK_REDIS__HOST": "redis",
          "AUTHENTIK_EMAIL__PASSWORD": "file:///run/secrets/smtp-password"
        },
        "volumes": [
          "/srv/homelab/data/authentik/media:/media",
          "/srv/homelab/data/authentik/templates:/templates",
          {
            "type": "bind",
            "source": "/opt/homelab-app/runtime/authentik-secret-key",
            "target": "/run/secrets/authentik-secret-key",
            "read_only": true,
            "bind": {
              "create_host_path": false
            }
          },
          {
            "type": "bind",
            "source": "/opt/homelab-app/runtime/postgresql-password",
            "target": "/run/secrets/postgresql-password",
            "read_only": true,
            "bind": {
              "create_host_path": false
            }
          },
          {
            "type": "bind",
            "source": "/opt/homelab-app/runtime/smtp-password",
            "target": "/run/secrets/smtp-password",
            "read_only": true,
            "bind": {
              "create_host_path": false
            }
          }
        ],
        "user": "1000:1000",
        "command": "server",
        "depends_on": {
          "redis": {
            "condition": "service_healthy"
          }
        },
        "ports": [
          "198.18.30.20:9000:9000"
        ]
      },
      "worker": {
        "image": "ghcr.io/goauthentik/server@sha256:dc07e81b4462a1dad9c6720f4c73993e37d7cb2d2f94a306187318704d112e71",
        "pull_policy": "missing",
        "restart": "always",
        "mem_limit": "768m",
        "cpus": 1,
        "pids_limit": 128,
        "stop_grace_period": "60s",
        "logging": {
          "driver": "json-file",
          "options": {
            "max-size": "10m",
            "max-file": "3"
          }
        },
        "environment": {
          "AUTHENTIK_EMAIL__HOST": "smtp.example.invalid",
          "AUTHENTIK_EMAIL__FROM": "sso@example.invalid",
          "AUTHENTIK_EMAIL__USE_TLS": "true",
          "TZ": "Etc/UTC",
          "AUTHENTIK_SECRET_KEY": "file:///run/secrets/authentik-secret-key",
          "AUTHENTIK_POSTGRESQL__HOST": "postgres",
          "AUTHENTIK_POSTGRESQL__USER": "authentik",
          "AUTHENTIK_POSTGRESQL__NAME": "authentik",
          "AUTHENTIK_POSTGRESQL__PASSWORD": "file:///run/secrets/postgresql-password",
          "AUTHENTIK_REDIS__HOST": "redis",
          "AUTHENTIK_EMAIL__PASSWORD": "file:///run/secrets/smtp-password"
        },
        "volumes": [
          "/srv/homelab/data/authentik/media:/media",
          "/srv/homelab/data/authentik/templates:/templates",
          "/srv/homelab/data/authentik/certs:/certs",
          {
            "type": "bind",
            "source": "/opt/homelab-app/runtime/authentik-secret-key",
            "target": "/run/secrets/authentik-secret-key",
            "read_only": true,
            "bind": {
              "create_host_path": false
            }
          },
          {
            "type": "bind",
            "source": "/opt/homelab-app/runtime/postgresql-password",
            "target": "/run/secrets/postgresql-password",
            "read_only": true,
            "bind": {
              "create_host_path": false
            }
          },
          {
            "type": "bind",
            "source": "/opt/homelab-app/runtime/smtp-password",
            "target": "/run/secrets/smtp-password",
            "read_only": true,
            "bind": {
              "create_host_path": false
            }
          }
        ],
        "user": "1000:1000",
        "command": "worker",
        "depends_on": {
          "redis": {
            "condition": "service_healthy"
          }
        }
      },
      "redis": {
        "image": "redis@sha256:6cbef353e480a8a6e7f10ec545f13d7d3fa85a212cdcc5ffaf5a1c818b9d3798",
        "pull_policy": "missing",
        "restart": "always",
        "mem_limit": "128m",
        "cpus": 1,
        "pids_limit": 128,
        "stop_grace_period": "60s",
        "logging": {
          "driver": "json-file",
          "options": {
            "max-size": "10m",
            "max-file": "3"
          }
        },
        "environment": {
          "TZ": "Etc/UTC"
        },
        "volumes": [
          "/srv/homelab/data/redis:/data"
        ],
        "command": [
          "redis-server",
          "--appendonly",
          "yes"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "redis-cli ping | grep -qx PONG"
          ],
          "start_period": "20s",
          "interval": "30s",
          "retries": 5,
          "timeout": "3s"
        }
      }
    }
  },
  "identity_files": [
