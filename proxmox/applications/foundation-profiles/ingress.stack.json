{
  "kind": "ingress",
  "data_root": "/srv/homelab/data",
  "guest_memory_mib": 768,
  "timezone": {
    "$ref": "timezone"
  },
  "services": {
    "traefik": {
      "image": "traefik@sha256:6b9cbca6fac42ab0075f5437d8dc1685cfd188626d8d515839ea94f8b6271c42",
      "memory_mib": 512,
      "cpus": 1,
      "pids_limit": 256,
      "restart": "unless-stopped",
      "environment": {},
      "extra_mounts": []
    }
  },
  "foundation": {
    "version": 1,
    "bind_address": {
      "$ref": "guests.ingress.interfaces.frontend.address"
    },
    "proxmox_url": "https://${host.address}:8006",
    "proxmox_token_id": "root@pam!homelab-traefik-${guests.ingress.vmid}",
    "acme_email": {
      "$ref": "ingress.acme_email"
    },
    "pve_ca_file": "/usr/local/share/ca-certificates/homelab-pve.crt",
    "secret_files": {
      "proxmox_token": "/var/lib/homelab-inputs/foundation-ingress/proxmox-token",
      "cloudflare_dns_token": "/var/lib/homelab-inputs/foundation-ingress/cloudflare-dns-token"
    },
    "acme_dns_resolvers": [
      "${dns.address}:53"
    ]
  }
}
