{
  "kind": "db-tools",
  "data_root": "/srv/homelab/data",
  "guest_memory_mib": 768,
  "timezone": {
    "$ref": "timezone"
  },
  "services": {
    "pgadmin": {
      "image": "dpage/pgadmin4@sha256:cefc4cc6b7d9d71a9e81e76fb9d7e14038ab5661b539a190eea1b63fa612589a",
      "memory_mib": 512,
      "cpus": 1,
      "pids_limit": 256,
      "restart": "unless-stopped",
      "environment": {},
      "extra_mounts": [],
      "user": "5050"
    }
  },
  "foundation": {
    "version": 1,
    "public_url": "https://${domains.db_tools}",
    "identity_url": "https://${domains.identity}",
    "oauth_client_id": {
      "$ref": "db_tools.oauth_client_id"
    },
    "oauth_name": "authentik",
    "provider_slug": {
      "$ref": "db_tools.provider_slug"
    },
    "secret_files": {
      "oauth_client_secret": "/var/lib/homelab-inputs/foundation-db-tools/oauth-client-secret"
    }
  },
  "pgadmin_bind_address": {
    "$ref": "guests.db-tools.interfaces.backend.address"
  }
}
