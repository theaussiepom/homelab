{
  "kind": "identity",
  "data_root": "/srv/homelab/data",
  "guest_memory_mib": 2048,
  "timezone": {
    "$ref": "timezone"
  },
  "services": {
    "server": {
      "image": "ghcr.io/goauthentik/server@sha256:dc07e81b4462a1dad9c6720f4c73993e37d7cb2d2f94a306187318704d112e71",
      "memory_mib": 768,
      "cpus": 1,
      "pids_limit": 256,
      "restart": "unless-stopped",
      "environment": {
        "$ref": "smtp"
      },
      "extra_mounts": [],
      "user": "1000"
    },
    "worker": {
      "image": "ghcr.io/goauthentik/server@sha256:dc07e81b4462a1dad9c6720f4c73993e37d7cb2d2f94a306187318704d112e71",
      "memory_mib": 768,
      "cpus": 1,
      "pids_limit": 256,
      "restart": "unless-stopped",
      "environment": {
        "$ref": "smtp"
      },
      "extra_mounts": [],
      "user": "1000"
    },
    "redis": {
      "image": "redis@sha256:6cbef353e480a8a6e7f10ec545f13d7d3fa85a212cdcc5ffaf5a1c818b9d3798",
      "memory_mib": 128,
      "cpus": 1,
      "pids_limit": 256,
      "restart": "unless-stopped",
      "environment": {},
      "extra_mounts": [],
      "command": [
        "--save",
        "60",
        "1",
        "--loglevel",
        "warning"
      ]
    }
  },
  "foundation": {
    "version": 1,
    "bind_address": {
      "$ref": "guests.identity.interfaces.backend.address"
    },
    "postgresql_host": {
      "$ref": "databases.postgresql.address"
    },
    "postgresql_user": {
      "$ref": "identity.postgresql_user"
    },
    "postgresql_database": {
      "$ref": "identity.postgresql_database"
    },
    "secret_files": {
      "secret_key": "/var/lib/homelab-inputs/foundation-identity/authentik-secret-key",
      "postgresql_password": "/var/lib/homelab-inputs/foundation-identity/postgresql-password"
    }
  }
}
