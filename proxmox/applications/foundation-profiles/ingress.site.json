{
  "site": {
    "$ref": "derived.site"
  },
  "paths": {
    "$ref": "derived.paths"
  },
  "ssh_public_keys": {
    "$ref": "ssh_public_keys"
  },
  "guest": {
    "vmid": {
      "$ref": "guests.ingress.vmid"
    },
    "hostname": {
      "$ref": "guests.ingress.hostname"
    },
    "cpu": 1,
    "memory_mib": 768,
    "root_gib": 4,
    "storage_id": {
      "$ref": "storage.id"
    },
    "template_file_id": {
      "$ref": "storage.template"
    },
    "started": true,
    "start_on_boot": true,
    "boot_order": 30,
    "nesting": true,
    "keyctl": false,
    "dns_servers": {
      "$ref": "derived.dns_servers"
    },
    "interfaces": {
      "$ref": "derived.interfaces.ingress"
    },
    "volumes": {
      "data": {
        "path": "/srv/homelab",
        "size_gib": 2
      }
    },
    "rules": {
      "$ref": "derived.rules.ingress"
    }
  },
  "app": {
    "kind": "ingress",
    "new_target": true,
    "vmid": {
      "$ref": "guests.ingress.vmid"
    },
    "hostname": {
      "$ref": "guests.ingress.hostname"
    },
    "memory_mib": 768,
    "address": {
      "$ref": "guests.ingress.interfaces.management.address"
    },
    "mac": {
      "$ref": "guests.ingress.interfaces.management.mac"
    },
    "packages": [
      "docker.io=26.1.5+dfsg1-9+deb13u1",
      "docker-cli=26.1.5+dfsg1-9+deb13u1",
      "docker-compose=2.26.1-4",
      "curl=8.14.1-2+deb13u7",
      "iproute2=6.15.0-1"
    ],
    "stack_config": "/var/lib/homelab-inputs/foundation-ingress/stack.json",
    "capture": {
      "path": "/srv/homelab-backups/foundation-captures/ingress-${guests.ingress.capture_sha256}.tar",
      "sha256": {
        "$ref": "guests.ingress.capture_sha256"
      },
      "coherent": true
    },
    "exclusive_writer_confirmed": true,
    "health_checks": [
      {
        "name": "Proxy health endpoint",
        "argv": [
          "curl",
          "--retry",
          "30",
          "--retry-delay",
          "2",
          "--retry-all-errors",
          "--retry-max-time",
          "180",
          "--fail",
          "--silent",
          "--show-error",
          "--max-time",
          "10",
          "http://127.0.0.1:8082/ping"
        ],
        "expect": "OK"
      }
    ]
  }
}
