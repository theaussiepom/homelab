{
  "site": {
    "$ref": "derived.site"
  },
  "paths": {
    "$ref": "derived.paths"
  },
  "ssh_public_keys": {
    "$ref": "ssh_public_keys"
  },
  "guest": {
    "vmid": {
      "$ref": "guests.db-tools.vmid"
    },
    "hostname": {
      "$ref": "guests.db-tools.hostname"
    },
    "cpu": 1,
    "memory_mib": 768,
    "root_gib": 4,
    "storage_id": {
      "$ref": "storage.id"
    },
    "template_file_id": {
      "$ref": "storage.template"
    },
    "started": true,
    "start_on_boot": true,
    "boot_order": 50,
    "nesting": true,
    "keyctl": false,
    "dns_servers": {
      "$ref": "derived.dns_servers"
    },
    "interfaces": {
      "$ref": "derived.interfaces.db-tools"
    },
    "volumes": {
      "data": {
        "path": "/srv/homelab",
        "size_gib": 2
      }
    },
    "rules": {
      "$ref": "derived.rules.db-tools"
    }
  },
  "app": {
    "kind": "db-tools",
    "new_target": true,
    "vmid": {
      "$ref": "guests.db-tools.vmid"
    },
    "hostname": {
      "$ref": "guests.db-tools.hostname"
    },
    "memory_mib": 768,
    "address": {
      "$ref": "guests.db-tools.interfaces.management.address"
    },
    "mac": {
      "$ref": "guests.db-tools.interfaces.management.mac"
    },
    "packages": [
      "docker.io=26.1.5+dfsg1-9+deb13u1",
      "docker-cli=26.1.5+dfsg1-9+deb13u1",
      "docker-compose=2.26.1-4",
      "curl=8.14.1-2+deb13u7"
    ],
    "stack_config": "/var/lib/homelab-inputs/foundation-db-tools/stack.json",
    "capture": {
      "path": "/srv/homelab-backups/foundation-captures/db-tools-${guests.db-tools.capture_sha256}.tar",
      "sha256": {
        "$ref": "guests.db-tools.capture_sha256"
      },
      "coherent": true
    },
    "exclusive_writer_confirmed": true,
    "health_checks": [
      {
        "name": "Preserved pgAdmin profile serves its login",
        "argv": [
          "curl",
          "--retry",
          "30",
          "--retry-delay",
          "2",
          "--retry-all-errors",
          "--retry-max-time",
          "180",
          "--fail",
          "--silent",
          "--show-error",
          "--max-time",
          "15",
          "http://${guests.db-tools.interfaces.backend.address}/login"
        ],
        "expect": ""
      },
      {
        "name": "Verified HTTPS identity discovery",
        "argv": [
          "curl",
          "--retry",
          "30",
          "--retry-delay",
          "2",
          "--retry-all-errors",
          "--retry-max-time",
          "180",
          "--fail",
          "--silent",
          "--show-error",
          "--max-time",
          "15",
          "--resolve",
          "${domains.identity}:443:${guests.ingress.interfaces.frontend.address}",
          "https://${domains.identity}/application/o/${db_tools.provider_slug}/.well-known/openid-configuration"
        ],
        "expect": "authorization_endpoint"
      },
      {
        "name": "Verified HTTPS pgAdmin route",
        "argv": [
          "curl",
          "--retry",
          "30",
          "--retry-delay",
          "2",
          "--retry-all-errors",
          "--retry-max-time",
          "180",
          "--fail",
          "--silent",
          "--show-error",
          "--max-time",
          "15",
          "--resolve",
          "${domains.db_tools}:443:${guests.ingress.interfaces.frontend.address}",
          "https://${domains.db_tools}/login"
        ],
        "expect": ""
      }
    ],
    "discovery_routes": [
      {
        "name": "pgadmin",
        "host": {
          "$ref": "domains.db_tools"
        },
        "url": "http://${guests.db-tools.interfaces.backend.address}:80"
      }
    ]
  }
}
