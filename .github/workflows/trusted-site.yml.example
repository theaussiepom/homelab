name: Trusted private site preview
on:
  workflow_call:
    inputs:
      site_ref:
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: private-site-infrastructure
  cancel-in-progress: false
jobs:
  preview:
    if: github.event.repository.private == true
    runs-on: [self-hosted, linux, x64, homelab-private-deploy]
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ inputs.site_ref }}
          path: site
          persist-credentials: false
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          repository: REPLACE_WITH_PUBLIC_IMPLEMENTATION_REPOSITORY
          ref: REPLACE_WITH_REVIEWED_40_HEX_COMMIT
          path: implementation
          persist-credentials: false
      - run: python implementation/bin/homelab validate --catalog site/catalog/site.json
      - name: Exact production adapter remains held in this draft
        run: python implementation/bin/homelab plan --catalog site/catalog/site.json --workspace site/.work/preview --target pve
# No apply job is supplied until I14/I23 approval, locking, encrypted plan,
# checkpoint-on-partial-failure and final verification are qualified together.
