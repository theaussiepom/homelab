[Unit]
Description=Private site deployment runner
After=network-online.target
Wants=network-online.target
ConditionPathExists={{ homelab_runner_directory }}/.runner

[Service]
User={{ homelab_runner_user }}
Group={{ homelab_runner_group }}
WorkingDirectory={{ homelab_runner_directory }}
ExecStart={{ homelab_runner_directory }}/run.sh
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
